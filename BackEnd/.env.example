# Database Configuration
DB_HOST=your_mysql_host
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=your_database_name
DB_PORT=3306

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration (Gmail)
# 1. Go to: https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to: https://myaccount.google.com/apppasswords
# 4. Create App Password (App: Mail, Device: Other)
# 5. Copy the 16-character password (without spaces)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=abcdefghijklmnop  # 16-character App Password (NOT your Gmail password!)

# Base URL for email verification links
BASE_URL=https://nandamotor.github.io

# WA Bot API
WA_BOT_API=http://localhost:5000

# Security
SECRET_KEY=your_secret_key_here
WEBHOOK_SECRET=your_webhook_secret_here

# Environment
NODE_ENV=production

# Email Verification
# Set to 'true' to skip email verification (development mode)
# Set to 'false' to enable email verification (production mode - requires valid EMAIL_PASSWORD)
SKIP_EMAIL_VERIFICATION=true

PORT=3000